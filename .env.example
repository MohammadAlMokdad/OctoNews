# Copy this file to .env for local runs. On GitHub, add these as Actions secrets instead.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Comma-separated fallback chains, tried in order (a busy/out-of-quota model falls through).
# Screening runs hourly -> needs a high-quota model. Writing is ~10 posts/day -> can use better, scarcer models.
# Defaults: screen = gemini-3.5-flash-lite,gemini-3.1-flash-lite
#           write  = gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# Run `python -m octonews.main --list-models` to see options; check quotas at aistudio.google.com (Rate limits).
GEMINI_SCREEN_MODELS=
GEMINI_WRITE_MODELS=

# Whapi.Cloud token (dashboard -> your channel -> API token)
WHAPI_TOKEN=
# Target WhatsApp Channel ID, ends with @newsletter. Run `python -m octonews.main --list-channels` to find it.
WHAPI_CHANNEL_ID=
